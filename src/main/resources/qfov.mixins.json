{
  "required": true,
  "minVersion": "0.8",
  "package": "qirieshka.qfov.mixin",
  "compatibilityLevel": "JAVA_25",
  "mixins": [
    "ClientboundBlockUpdatePacketMixin",
    "ClientboundLevelChunkPacketDataMixin",
    "ClientboundSectionBlocksUpdatePacketMixin",
    "ChunkHolderMixin",
    "ServerLevelMixin"
  ],
  "client": [
    "GameOptionsMixin",
    "CameraMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
